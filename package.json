{
  "name": "sops-secret",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Edit, add, remove and list values in sops-encrypted files, with the age key in 1Password",
  "type": "module",
  "bin": {
    "sops-secret": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activescott/sops-secret.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && node --test 'test/**/*.test.ts'",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1"
  }
}
